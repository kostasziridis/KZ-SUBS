    },
    "The one-time setup could not finish. Check your connection and try again — after this, subtitles work offline.": {
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η ρύθμιση δεν ολοκληρώθηκε. Ελέγξτε τη σύνδεσή σας και δοκιμάστε ξανά — μετά, οι υπότιτλοι δουλεύουν χωρίς internet."
          }
        }
